# Copie para .env se quiser ativar recuperação por email ou SMS.
# Nunca envie o ficheiro .env para o GitHub. Sem estas opções o envio fica desativado.

# Email: chave Resend e endereço de envio de um domínio verificado na sua conta.
RESEND_API_KEY=
RECOVERY_EMAIL_FROM=

# SMS: credenciais Twilio e número de envio autorizado, com indicativo internacional.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# Em produção HTTPS, ative cookies Secure.
# COOKIE_SECURE=1
# Numa instalação independente sem pré-visualização incorporada:
# FRAME_ANCESTORS="'none'"
